#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

cd "${SCRIPT_DIR}"

if [[ ! -f ".env" ]]; then
  echo "No .env file found in ${SCRIPT_DIR}, using system environment variables"
fi

# modernc.org/sqlite is pure Go, so cgo is not required.
: "${CGO_ENABLED:=0}"

go run ./cmd "$@"
